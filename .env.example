APP_NAME=PipeMind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Port 5434, not 5432: this machine already runs a host PostgreSQL on 5432 and
# another project's container on 5433. Docker Compose reads DB_PORT from this
# same file, so host and container stay in sync automatically.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=pipemind
DB_USERNAME=pipemind
DB_PASSWORD=secret

# --- Redis ------------------------------------------------------------------
# Port 6380: a host redis-server occupies 6379.
# predis (pure PHP) — no ext-redis required.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Object storage (raw CI logs) -------------------------------------------
FILESYSTEM_DISK=logs
AWS_ACCESS_KEY_ID=pipemind
AWS_SECRET_ACCESS_KEY=pipemind123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=pipemind-logs
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail (Mailpit) ---------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@pipemind.local
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth -------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# --- Broadcasting (file 17) -------------------------------------------------
# Port 8081: another project holds 8080.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=pipemind
REVERB_APP_KEY=pipemind-key
REVERB_APP_SECRET=change-me
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# --- PipeMind AI service ----------------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=change-me-shared-secret
AI_SERVICE_TIMEOUT=120
AI_CONTRACT_VERSION=v1

# --- Providers --------------------------------------------------------------
GITLAB_DEFAULT_URL=https://gitlab.com
PIPEMIND_WEBHOOK_TOLERANCE_SECONDS=300

# --- Compose only -----------------------------------------------------------
MINIO_USER=pipemind
MINIO_PASSWORD=pipemind123
